# Kopie als .env anlegen (wird nicht committet)
PORT=3000
NODE_ENV=production
# Pflicht in Produktion: langer Zufallswert, z. B. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
SESSION_SECRET=
# Einmal-Token zum Anlegen des ersten Admins ueber /verwaltung/einrichten
ADMIN_SETUP_TOKEN=
# Optional: hinter Reverse-Proxy mit HTTPS
TRUST_PROXY=0
SECURE_COOKIES=0
