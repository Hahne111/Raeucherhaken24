      <div class="ad-top__meta">
        <% if (typeof headActions !== 'undefined') { %><%- headActions %><% } %>
      </div>
    </header>
    <div class="ad-body">
      <% (flashes || []).forEach(function (f) { %>
        <div class="ad-alert ad-alert--<%= f.type %>"><%= f.message %></div>
      <% }); %>
