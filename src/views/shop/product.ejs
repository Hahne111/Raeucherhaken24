<%- include('../partials/head') %>
<%- include('../partials/header') %>
<% var firstAvailable = variants.find(function (v) { return v.stock > 0; }) || variants[0] || null; %>
<main id="inhalt" class="page">
  <div class="wrap">
    <nav class="crumbs" aria-label="Pfad">
      <a href="/">Start</a><span>/</span>
      <a href="/produkte">Produkte</a><span>/</span>
      <% if (product.category_slug) { %><a href="/kategorie/<%= product.category_slug %>"><%= product.category_name %></a><span>/</span><% } %>
      <span><%= product.name %></span>
    </nav>

    <div class="section">
      <div class="pdp">
        <div>
          <div class="gallery__main">
            <img id="gallery-main" src="<%= images.length ? images[0].url : product.image %>"
                 alt="<%= images.length ? (images[0].alt || product.name) : product.name %>" width="400" height="300">
          </div>
          <% if (images.length > 1) { %>
            <div class="gallery__thumbs">
              <% images.forEach(function (img, i) { %>
                <button type="button" class="<%= i === 0 ? 'is-active' : '' %>" data-image="<%= img.url %>" data-alt="<%= img.alt || product.name %>">
                  <img src="<%= img.url %>" alt="Ansicht <%= i + 1 %>" width="78" height="62" loading="lazy">
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div>
          <% if (product.category_name) { %><p class="pagehead__eyebrow"><%= product.category_name %></p><% } %>
          <h1 class="pdp__title"><%= product.name %></h1>
          <p class="pdp__sub"><%= product.subtitle %></p>

          <div class="pdp__price">
            <span class="price" data-price><%= fmt(firstAvailable ? firstAvailable.price_cents : product.price_cents) %></span>
            <% if (product.on_sale) { %><s style="color:#99a3ab"><%= fmt(product.compare_cents) %></s><% } %>
          </div>
          <p class="pdp__meta">
            inkl. <%= settings.num('shop.tax_rate', 19) %> % MwSt.
            <% if (site.freeFrom) { %>· versandkostenfrei ab <%= fmt(site.freeFrom) %><% } %>
            · Art.-Nr. <span data-sku><%= firstAvailable ? (firstAvailable.sku || product.sku) : product.sku %></span>
          </p>

          <form action="/warenkorb/hinzufuegen" method="post" id="add-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <input type="hidden" name="redirect" value="/warenkorb">

            <% if (variants.length > 1) { %>
              <p class="field__label" style="margin-bottom:8px">Variante</p>
              <div class="variants" role="radiogroup" aria-label="Variante wählen">
                <% variants.forEach(function (v) { %>
                  <label class="variant <%= firstAvailable && v.id === firstAvailable.id ? 'is-active' : '' %> <%= v.stock <= 0 ? 'is-out' : '' %>"
                         data-variant data-price="<%= fmt(v.price_cents) %>" data-stock="<%= v.stock %>" data-sku="<%= v.sku %>">
                    <input type="radio" name="variant_id" value="<%= v.id %>" class="visually-hidden"
                           <%= firstAvailable && v.id === firstAvailable.id ? 'checked' : '' %> <%= v.stock <= 0 ? 'disabled' : '' %>>
                    <strong><%= v.name %></strong>
                    <span><%= fmt(v.price_cents) %> · <%= v.stock > 0 ? (v.stock < 10 ? 'nur noch ' + v.stock : 'auf Lager') : 'ausverkauft' %></span>
                  </label>
                <% }); %>
              </div>
            <% } else if (firstAvailable) { %>
              <input type="hidden" name="variant_id" value="<%= firstAvailable.id %>">
            <% } %>

            <div class="addrow">
              <div class="qty">
                <button type="button" data-qty="down" aria-label="Menge verringern">−</button>
                <label class="visually-hidden" for="qty">Menge</label>
                <input id="qty" type="number" name="qty" value="1" min="1" max="99" inputmode="numeric">
                <button type="button" data-qty="up" aria-label="Menge erhöhen">+</button>
              </div>
              <button class="btn btn--primary" type="submit" style="flex:1 1 auto" <%= product.in_stock ? '' : 'disabled' %>>
                <svg aria-hidden="true"><use href="#i-cart"/></svg>
                <%= product.in_stock ? 'In den Warenkorb' : 'Derzeit ausverkauft' %>
              </button>
            </div>
          </form>

          <p class="stockdot <%= product.in_stock ? (product.stock_total < 10 ? 'stockdot--low' : '') : 'stockdot--out' %>" data-stockline>
            <%= product.in_stock ? (product.stock_total < 10 ? 'Nur noch ' + product.stock_total + ' Stück verfügbar' : 'Auf Lager – versandfertig in 24 Stunden') : 'Derzeit nicht verfügbar' %>
          </p>

          <ul style="list-style:none;padding:0;margin:20px 0 0;font-size:14px;color:var(--ink-soft);display:grid;gap:9px">
            <li style="display:flex;gap:9px;align-items:center"><svg style="width:17px;height:17px;color:var(--copper-700)"><use href="#i-truck"/></svg> Versand mit DHL, Lieferzeit 2–4 Werktage</li>
            <li style="display:flex;gap:9px;align-items:center"><svg style="width:17px;height:17px;color:var(--copper-700)"><use href="#i-shield"/></svg> 14 Tage Widerrufsrecht</li>
            <li style="display:flex;gap:9px;align-items:center"><svg style="width:17px;height:17px;color:var(--copper-700)"><use href="#i-headset"/></svg> Beratung per E-Mail: <%= site.email %></li>
          </ul>
        </div>
      </div>

      <div class="tabs">
        <ul class="tabs__nav" role="tablist">
          <li><button type="button" role="tab" class="is-active" aria-selected="true" aria-controls="tab-desc" id="tabbtn-desc">Beschreibung</button></li>
          <li><button type="button" role="tab" aria-selected="false" aria-controls="tab-spec" id="tabbtn-spec">Details</button></li>
          <li><button type="button" role="tab" aria-selected="false" aria-controls="tab-ship" id="tabbtn-ship">Versand</button></li>
        </ul>
        <div class="tabs__panel" id="tab-desc" role="tabpanel" aria-labelledby="tabbtn-desc">
          <%- textToHtml(product.description) %>
          <% if (product.details) { %><%- textToHtml(product.details) %><% } %>
        </div>
        <div class="tabs__panel" id="tab-spec" role="tabpanel" aria-labelledby="tabbtn-spec" hidden>
          <table class="spec">
            <tbody>
              <tr><th>Artikelnummer</th><td><%= product.sku %></td></tr>
              <% if (product.material) { %><tr><th>Material</th><td><%= product.material %></td></tr><% } %>
              <% if (product.weight_g) { %><tr><th>Gewicht</th><td><%= product.weight_g >= 1000 ? (product.weight_g/1000).toFixed(1).replace('.', ',') + ' kg' : product.weight_g + ' g' %></td></tr><% } %>
              <% if (product.brand) { %><tr><th>Marke</th><td><%= product.brand %></td></tr><% } %>
              <% facets.forEach(function (f) { %><tr><th><%= f.key %></th><td><%= f.value %></td></tr><% }); %>
              <% if (variants.length > 1) { %>
                <tr><th>Varianten</th><td><%= variants.map(function (v) { return v.name; }).join(', ') %></td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <div class="tabs__panel" id="tab-ship" role="tabpanel" aria-labelledby="tabbtn-ship" hidden>
          <%- textToHtml(settings.get('seite.versand', '').split('\n').slice(1).join('\n')) %>
        </div>
      </div>

      <div id="bewertungen" style="margin-top:52px">
        <h2 style="font-size:26px;color:var(--navy-800);margin-bottom:6px">Bewertungen</h2>
        <% if (reviewSummary.count) { %>
          <p class="review__meta" style="margin-bottom:18px">
            <span class="review__stars"><%= '★'.repeat(Math.round(reviewSummary.average)) + '☆'.repeat(5 - Math.round(reviewSummary.average)) %></span>
            <%= String(reviewSummary.average).replace('.', ',') %> von 5 aus <%= reviewSummary.count %> Bewertung<%= reviewSummary.count === 1 ? '' : 'en' %>
          </p>
        <% } else { %>
          <p class="review__meta" style="margin-bottom:18px">Für dieses Produkt gibt es noch keine freigegebene Bewertung.</p>
        <% } %>

        <% if (reviews.length) { %>
        <div class="reviews">
          <% reviews.forEach(function (r) { %>
            <article class="review">
              <div class="review__head">
                <div>
                  <span class="review__stars"><%= '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating) %></span>
                  <% if (r.title) { %><strong style="margin-left:8px"><%= r.title %></strong><% } %>
                </div>
                <span class="review__meta"><%= r.author %> · <%= formatDay(r.created_at) %><% if (r.verified) { %> · <span class="review__verified">Gekauft</span><% } %></span>
              </div>
              <p style="margin-top:10px;white-space:pre-line"><%= r.body %></p>
              <% if (r.reply) { %>
                <div class="review__reply"><strong>Antwort von Räucherhaken24:</strong><br><span style="white-space:pre-line"><%= r.reply %></span></div>
              <% } %>
            </article>
          <% }); %>
        </div>
        <% } %>

        <div class="panel" style="margin-top:20px"><div class="panel__body">
          <% if (!customer) { %>
            <p>Bewerten können angemeldete Kundinnen und Kunden.
              <a href="/konto/anmelden?weiter=<%= encodeURIComponent('/produkt/' + product.slug) %>">Jetzt anmelden</a>.</p>
          <% } else if (ownReview) { %>
            <p>Du hast dieses Produkt bereits bewertet.
              <% if (ownReview.status === 'offen') { %>Deine Bewertung wird geprüft und erscheint nach der Freigabe.<% } %>
              <% if (ownReview.status === 'abgelehnt') { %>Deine Bewertung wurde nicht veröffentlicht.<% } %>
            </p>
          <% } else { %>
            <h3 style="margin-bottom:12px">Deine Bewertung</h3>
            <% if (boughtIt) { %><p class="review__meta">Wir haben eine Bestellung mit diesem Produkt gefunden – deine Bewertung wird als „Gekauft“ gekennzeichnet.</p><% } %>
            <form method="post" action="/produkt/<%= product.slug %>/bewertung" class="review-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <label>Sterne
                <select name="rating" required>
                  <% [5, 4, 3, 2, 1].forEach(function (n) { %><option value="<%= n %>"><%= n %> von 5</option><% }); %>
                </select>
              </label>
              <label>Überschrift <input type="text" name="title" maxlength="120"></label>
              <label>Dein Text <textarea name="body" rows="4" required minlength="10" maxlength="4000"></textarea></label>
              <button class="btn btn--dark" type="submit">Bewertung abschicken</button>
            </form>
            <p class="review__meta" style="margin-top:10px">Jede Bewertung wird vor der Veröffentlichung geprüft.</p>
          <% } %>
        </div></div>
      </div>

      <% if (related.length) { %>
        <div style="margin-top:52px">
          <h2 style="font-size:26px;color:var(--navy-800);margin-bottom:18px">Passt dazu</h2>
          <div class="grid-products grid-products--4">
            <% related.forEach(function (p) { %>
              <article class="pcard">
                <a class="pcard__media" href="/produkt/<%= p.slug %>">
                  <img src="<%= p.image %>" alt="<%= p.image_alt || p.name %>" width="400" height="300" loading="lazy">
                </a>
                <div class="pcard__body">
                  <h3 class="pcard__title" style="font-size:16px"><a href="/produkt/<%= p.slug %>"><%= p.name %></a></h3>
                  <div class="pcard__foot">
                    <span class="price" style="font-size:18px"><%= fmt(p.price_from) %></span>
                    <form action="/warenkorb/hinzufuegen" method="post" data-cart-form>
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <input type="hidden" name="variant_id" value="<%= p.default_variant_id %>">
                      <input type="hidden" name="qty" value="1">
                      <input type="hidden" name="redirect" value="<%= currentPath %>">
                      <button class="btn-cart" type="submit" <%= p.in_stock ? '' : 'disabled' %> aria-label="<%= p.name %> in den Warenkorb legen">
                        <svg aria-hidden="true"><use href="#i-cart"/></svg>
                      </button>
                    </form>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        </div>
      <% } %>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
