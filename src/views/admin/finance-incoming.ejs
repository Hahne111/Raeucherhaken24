<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/finanzen">Zum Cockpit</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="toolbar">
  <form method="get" action="/verwaltung/finanzen/eingangsbelege">
    <input type="search" name="q" value="<%= q %>" placeholder="Nummer, Lieferant, Text" aria-label="Suche">
    <select name="status" aria-label="Status">
      <option value="">Alle Status</option>
      <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
    </select>
    <button class="btn btn--dark btn--sm" type="submit">Filtern</button>
  </form>
</div>
<div class="card">
  <div class="card__head"><h2><%= rows.length %> Eingangsbelege</h2></div>
  <div class="card__body card__body--flush">
    <% if (!rows.length) { %><p style="padding:20px;margin:0;color:var(--a-soft)">Noch kein Eingangsbeleg.</p><% } else { %>
    <table class="tbl">
      <thead><tr><th>Beleg</th><th>Lieferant</th><th>Datum</th><th>Fällig</th><th class="num">Brutto</th><th class="num">Steuer</th><th class="num">Bezahlt</th><th>Konto</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.number || '–' %><% if (r.url) { %><br><a class="link" href="<%= r.url %>" target="_blank" rel="noopener">Datei</a><% } %><% if (r.purchase_number) { %><br><span style="font-size:12px;color:var(--a-soft)">zu <%= r.purchase_number %></span><% } %></td>
            <td><%= r.supplier_name || '–' %></td>
            <td><%= r.doc_date %></td>
            <td><%= r.due_at || '–' %></td>
            <td class="num"><%= fmt(r.gross_cents) %></td>
            <td class="num"><%= fmt(r.tax_cents) %></td>
            <td class="num"><%= fmt(r.paid_cents) %></td>
            <td><%= r.account_number ? r.account_number + ' ' + r.account_name : '–' %></td>
            <td><span class="pill <%= r.status === 'bezahlt' ? 'pill--ok' : (r.status === 'neu' ? 'pill--warn' : '') %>"><%= states[r.status] || r.status %></span></td>
            <td class="num">
              <% if (canWrite) { %>
              <form method="post" action="/verwaltung/finanzen/eingangsbelege/<%= r.id %>/status" style="display:flex;gap:6px;justify-content:flex-end">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <select name="status">
                  <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= r.status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
                </select>
                <select name="account_id">
                  <option value="">Konto …</option>
                  <% accounts.forEach(function (a) { %><option value="<%= a.id %>" <%= String(r.account_id||'') === String(a.id) ? 'selected' : '' %>><%= a.number %></option><% }); %>
                </select>
                <button class="btn btn--dark btn--sm" type="submit">Speichern</button>
              </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<% if (canWrite) { %>
<div class="card">
  <div class="card__head"><h2>Beleg erfassen</h2></div>
  <div class="card__body">
    <form method="post" action="/verwaltung/finanzen/eingangsbelege">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <div class="field-row">
        <label class="field"><span>Belegnummer</span><input type="text" name="number" maxlength="80"></label>
        <label class="field"><span>Lieferant</span>
          <select name="supplier_id">
            <option value="">– ohne –</option>
            <% suppliers.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name %></option><% }); %>
          </select>
        </label>
        <label class="field"><span>Einkaufsbestellung</span>
          <select name="purchase_id">
            <option value="">– ohne –</option>
            <% purchases.forEach(function (p) { %><option value="<%= p.id %>"><%= p.number %></option><% }); %>
          </select>
        </label>
      </div>
      <div class="field-row">
        <label class="field"><span>Belegdatum</span><input type="date" name="doc_date" value="<%= new Date().toISOString().slice(0,10) %>"></label>
        <label class="field"><span>Fällig am</span><input type="date" name="due_at"></label>
        <label class="field"><span>Brutto *</span><input type="text" name="gross" required placeholder="z. B. 238,00"></label>
        <label class="field"><span>davon Steuer</span><input type="text" name="tax" placeholder="z. B. 38,00"></label>
      </div>
      <div class="field-row">
        <label class="field"><span>Kategorie</span><input type="text" name="category" maxlength="80" placeholder="z. B. Wareneinkauf"></label>
        <label class="field"><span>Konto</span>
          <select name="account_id">
            <option value="">– später –</option>
            <% accounts.forEach(function (a) { %><option value="<%= a.id %>"><%= a.number %> · <%= a.name %></option><% }); %>
          </select>
        </label>
        <label class="field"><span>Datei aus der Medienablage</span><input type="text" name="url" placeholder="/uploads/…"></label>
      </div>
      <label class="field"><span>Notiz</span><input type="text" name="note" maxlength="1000"></label>
      <button class="btn btn--primary" type="submit">Beleg erfassen</button>
    </form>
  </div>
</div>
<% } %>
<%- include('../partials/admin-foot') %>
