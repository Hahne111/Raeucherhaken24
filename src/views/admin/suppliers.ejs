<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--primary btn--sm" href="/verwaltung/lieferanten/neu">Lieferant anlegen</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="toolbar">
  <form method="get" action="/verwaltung/lieferanten">
    <input type="search" name="q" value="<%= q %>" placeholder="Name, Ort, Kontakt" aria-label="Suche">
    <button class="btn btn--dark btn--sm" type="submit">Suchen</button>
    <a class="btn btn--ghost btn--sm" href="/verwaltung/lieferanten">Zurücksetzen</a>
  </form>
</div>
<div class="card">
  <div class="card__head"><h2><%= rows.length %> Lieferanten</h2></div>
  <div class="card__body card__body--flush">
    <% if (!rows.length) { %><p style="padding:20px;margin:0;color:var(--a-soft)">Noch kein Lieferant angelegt.</p><% } else { %>
    <table class="tbl">
      <thead><tr><th>Name</th><th>Ort</th><th>Kontakt</th><th class="num">Artikel</th><th class="num">Offene Bestellungen</th><th class="num">Offener Wert</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% rows.forEach(function (s) { %>
          <tr>
            <td><a class="link" href="/verwaltung/lieferanten/<%= s.id %>"><%= s.name %></a><% if (s.customer_no) { %><br><span style="font-size:12px;color:var(--a-soft)">Kd.-Nr. <%= s.customer_no %></span><% } %></td>
            <td><%= s.zip %> <%= s.city %></td>
            <td><%= s.contact_name || '–' %><% if (s.email) { %><br><span style="font-size:12px;color:var(--a-soft)"><%= s.email %></span><% } %></td>
            <td class="num"><%= s.item_count %></td>
            <td class="num"><%= s.open_orders %></td>
            <td class="num"><%= fmt(s.open_value) %></td>
            <td><span class="pill <%= s.active ? 'pill--ok' : 'pill--err' %>"><%= s.active ? 'aktiv' : 'inaktiv' %></span></td>
            <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/lieferanten/<%= s.id %>">Öffnen</a></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<%- include('../partials/admin-foot') %>
