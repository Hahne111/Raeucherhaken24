<!doctype html>
<html lang="de"><head><meta charset="utf-8"><title>Etiketten – Lauf <%= run.id %></title>
<link rel="stylesheet" href="/css/admin.css">
<style>
  @page { size: A4; margin: <%= template.margin_mm %>mm; }
  body { margin: 0; background: #fff; }
  .sheet {
    display: grid;
    grid-template-columns: repeat(<%= template.columns %>, <%= template.width_mm %>mm);
    gap: <%= template.gap_mm %>mm;
    align-content: start;
  }
  .label {
    width: <%= template.width_mm %>mm; height: <%= template.height_mm %>mm;
    box-sizing: border-box; padding: 2mm; overflow: hidden;
    display: flex; flex-direction: column; justify-content: space-between;
    font-family: Arial, Helvetica, sans-serif; font-size: <%= (2.6 * template.font_scale).toFixed(2) %>mm;
    line-height: 1.25; break-inside: avoid;
  }
  .label__line--first { font-weight: 700; }
  .label__code svg { display: block; margin-top: 1mm; }
  @media screen { body { padding: 10mm; } .label { outline: 1px dashed #bbb; } }
</style>
</head><body>
<div class="sheet">
  <% labels.forEach(function (l) { %>
    <div class="label">
      <div>
        <% l.lines.forEach(function (line, i) { %>
          <div class="label__line <%= i === 0 ? 'label__line--first' : '' %>"><%= line.value %></div>
        <% }); %>
      </div>
      <% if (l.svg) { %><div class="label__code"><%- l.svg %></div><% } %>
    </div>
  <% }); %>
</div>
<script>window.onload = function () { window.print(); };</script>
</body></html>
