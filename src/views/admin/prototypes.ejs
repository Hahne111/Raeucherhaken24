<%- include('../partials/admin-head') %>
<%- include('../partials/admin-shell') %>
<div class="toolbar">
  <form method="get" action="/verwaltung/prototypen">
    <input type="search" name="q" value="<%= q %>" placeholder="Nummer, Titel, Kunde" aria-label="Suche">
    <select name="status" aria-label="Status">
      <option value="">Alle Status</option>
      <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
    </select>
    <button class="btn btn--dark btn--sm" type="submit">Suchen</button>
    <a class="btn btn--ghost btn--sm" href="/verwaltung/prototypen">Zurücksetzen</a>
  </form>
</div>
<div class="cols">
  <div class="card">
    <div class="card__head"><h2><%= rows.length %> Projekte</h2></div>
    <div class="card__body card__body--flush">
      <% if (!rows.length) { %><p style="padding:20px;margin:0;color:var(--a-soft)">Noch kein Prototypprojekt.</p><% } else { %>
      <table class="tbl">
        <thead><tr><th>Nummer</th><th>Titel</th><th>Kunde</th><th>Status</th><th class="num">Preis</th><th class="num">Bezahlt</th><th>Frist</th><th></th></tr></thead>
        <tbody>
          <% rows.forEach(function (p) { %>
            <tr>
              <td><a class="link" href="/verwaltung/prototypen/<%= p.id %>"><%= p.number %></a></td>
              <td><%= p.title %></td>
              <td><% if (p.customer_id) { %><a class="link" href="/verwaltung/kunden/<%= p.customer_id %>"><%= p.customer_company || p.customer_email %></a><% } else { %>–<% } %></td>
              <td><span class="pill <%= p.status === 'abgeschlossen' ? 'pill--ok' : (p.status === 'abgelehnt' ? 'pill--err' : '') %>"><%= states[p.status] || p.status %></span></td>
              <td class="num"><%= fmt(p.price_cents) %></td>
              <td class="num"><%= fmt(p.paid_cents) %></td>
              <td><%= p.due_at || '–' %></td>
              <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/prototypen/<%= p.id %>">Öffnen</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
  <% if (canWrite) { %>
  <div class="card">
    <div class="card__head"><h2>Neues Projekt</h2></div>
    <div class="card__body">
      <form method="post" action="/verwaltung/prototypen/neu">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <label class="field"><span>Titel *</span><input type="text" name="title" required maxlength="200"></label>
        <label class="field"><span>Kunde</span>
          <select name="customer_id">
            <option value="">– ohne Kunde –</option>
            <% customers.forEach(function (c) { %><option value="<%= c.id %>"><%= c.company || c.last_name || c.email %></option><% }); %>
          </select>
        </label>
        <label class="field"><span>Beschreibung</span><textarea name="description" rows="4"></textarea></label>
        <div class="field-row">
          <label class="field"><span>Preis</span><input type="text" name="price" placeholder="z. B. 450,00"></label>
          <label class="field"><span>Frist</span><input type="date" name="due_at"></label>
        </div>
        <label class="field"><span>Zuständig</span>
          <select name="assigned_to">
            <option value="">– offen –</option>
            <% staff.forEach(function (s) { %><option value="<%= s.id %>"><%= s.name || s.email %></option><% }); %>
          </select>
        </label>
        <button class="btn btn--primary btn--block" type="submit">Projekt anlegen</button>
      </form>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/admin-foot') %>
