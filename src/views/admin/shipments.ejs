<%- include('../partials/admin-head') %>
<%- include('../partials/admin-shell') %>
<div class="ad-alert ad-alert--info">
  <strong>Anbindung der Dienstleister:</strong>
  DHL – <%= api.dhl.configured ? 'konfiguriert, aber noch nicht gegen die Schnittstelle geprüft' : 'nicht eingerichtet (' + api.dhl.missing.join(', ') + ')' %>;
  DPD – <%= api.dpd.configured ? 'konfiguriert, aber noch nicht gegen die Schnittstelle geprüft' : 'nicht eingerichtet (' + api.dpd.missing.join(', ') + ')' %>.
  Label-Erzeugung und automatisches Tracking bleiben gesperrt; Sendungsnummern werden manuell erfasst und als solche gekennzeichnet.
</div>
<div class="toolbar">
  <form method="get" action="/verwaltung/versand">
    <input type="search" name="q" value="<%= q %>" placeholder="Sendungsnummer, Bestellung, E-Mail" aria-label="Suche">
    <select name="status" aria-label="Status">
      <option value="">Alle Status</option>
      <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
    </select>
    <select name="dienst" aria-label="Dienstleister">
      <option value="">Alle Dienstleister</option>
      <% carriers.forEach(function (c) { %><option value="<%= c.code %>" <%= carrier === c.code ? 'selected' : '' %>><%= c.name %></option><% }); %>
    </select>
    <button class="btn btn--dark btn--sm" type="submit">Suchen</button>
    <a class="btn btn--ghost btn--sm" href="/verwaltung/versand">Zurücksetzen</a>
  </form>
</div>
<div class="cols">
  <div class="card">
    <div class="card__head"><h2><%= result.total %> Sendungen</h2></div>
    <div class="card__body card__body--flush">
      <% if (!result.rows.length) { %>
        <p style="padding:20px;margin:0;color:var(--a-soft)">Noch keine Sendung. Sendungen entstehen aus einer Bestellung.</p>
      <% } else { %>
      <table class="tbl">
        <thead><tr><th>Sendung</th><th>Bestellung</th><th>Dienstleister</th><th>Sendungsnummer</th><th>Quelle</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% result.rows.forEach(function (s) { %>
            <tr>
              <td><a class="link" href="/verwaltung/versand/<%= s.id %>">#<%= s.id %></a></td>
              <td><a class="link" href="/verwaltung/bestellungen/<%= s.order_id %>"><%= s.order_number %></a></td>
              <td><%= s.carrier_name || s.carrier_code || '–' %></td>
              <td><%= s.tracking_code || '–' %></td>
              <td><span class="pill"><%= s.source === 'api' ? 'Schnittstelle' : 'manuell' %></span></td>
              <td><span class="pill <%= s.status === 'zugestellt' ? 'pill--ok' : '' %>"><%= states[s.status] || s.status %></span></td>
              <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/versand/<%= s.id %>">Öffnen</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card__head"><h2>Zu versenden</h2></div>
    <div class="card__body card__body--flush">
      <% if (!ready.length) { %><p style="padding:18px;margin:0;color:var(--a-soft)">Keine offene Bestellung.</p><% } else { %>
      <table class="tbl">
        <thead><tr><th>Bestellung</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% ready.forEach(function (o) { %>
            <tr><td><%= o.number %><br><span style="font-size:12px;color:var(--a-soft)"><%= formatDay(o.created_at) %></span></td>
              <td><span class="pill"><%= o.shipping_status %></span></td>
              <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/bestellungen/<%= o.id %>">Öffnen</a></td></tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/admin-foot') %>
