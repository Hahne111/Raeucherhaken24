<!doctype html>
<html lang="de"><head><meta charset="utf-8"><title><%= book.name %> – Gebietsbuch</title>
<link rel="stylesheet" href="/css/admin.css"></head><body class="is-print">
<h1 style="font-size:20px;margin:0 0 4px"><%= book.name %></h1>
<p style="margin:0 0 16px;font-size:12px;color:#555"><%= book.territory_name || 'ohne Gebiet' %> · <%= rows.length %> Einträge · Stand <%= formatDate(new Date().toISOString()) %></p>
<table class="tbl">
  <thead><tr><th>Firma</th><th>Branche</th><th>Kontakt</th><th>Telefon</th><th>Ort</th><th>Status</th><th>Wiedervorlage</th></tr></thead>
  <tbody>
    <% rows.forEach(function (e) { %>
      <tr><td><%= e.company %></td><td><%= e.branch %></td><td><%= e.contact %></td><td><%= e.phone %></td>
        <td><%= e.zip %> <%= e.city %></td><td><%= contactStates[e.contact_status] || e.contact_status %></td><td><%= e.followup_at || '' %></td></tr>
    <% }); %>
  </tbody>
</table>
</body></html>
