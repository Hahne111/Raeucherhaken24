<%- include('../partials/admin-head') %>
<%- include('../partials/admin-shell') %>
<div class="cols">
  <div>
    <div class="card">
      <div class="card__head">
        <h2>Positionen</h2>
        <span style="color:var(--a-soft);font-size:13px">Eingegangen am <%= formatDate(order.created_at) %></span>
      </div>
      <div class="card__body card__body--flush">
        <table class="tbl">
          <thead><tr><th>Artikel</th><th>Art.-Nr.</th><th class="num">Einzelpreis</th><th class="num">Menge</th><th class="num">Summe</th></tr></thead>
          <tbody>
            <% items.forEach(function (item) { %>
              <tr>
                <td><%= item.name %><br><small style="color:var(--a-soft)"><%= item.variant_name %></small></td>
                <td><%= item.sku %></td>
                <td class="num"><%= fmt(item.unit_price_cents) %></td>
                <td class="num"><%= item.qty %></td>
                <td class="num"><%= fmt(item.total_cents) %></td>
              </tr>
            <% }); %>
          </tbody>
          <tfoot>
            <tr><td colspan="4" class="num">Zwischensumme</td><td class="num"><%= fmt(order.subtotal_cents) %></td></tr>
            <% if (order.discount_cents > 0) { %>
              <tr><td colspan="4" class="num">Gutschein <%= order.coupon_code %></td><td class="num">− <%= fmt(order.discount_cents) %></td></tr>
            <% } %>
            <tr><td colspan="4" class="num">Versand (<%= order.shipping_name %>)</td><td class="num"><%= fmt(order.shipping_cents) %></td></tr>
            <tr><td colspan="4" class="num"><strong>Gesamt</strong></td><td class="num"><strong><%= fmt(order.total_cents) %></strong></td></tr>
            <tr><td colspan="4" class="num" style="color:var(--a-soft)">davon MwSt.</td><td class="num" style="color:var(--a-soft)"><%= fmt(order.tax_cents) %></td></tr>
          </tfoot>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><h2>Adressen</h2></div>
      <div class="card__body" style="display:grid;grid-template-columns:1fr 1fr;gap:22px">
        <div>
          <h3 style="font-size:13px;font-family:var(--sans);text-transform:uppercase;color:var(--a-soft);margin-bottom:8px">Lieferadresse</h3>
          <p style="white-space:pre-line;margin:0"><%= addressLib.format(shipping) %></p>
        </div>
        <div>
          <h3 style="font-size:13px;font-family:var(--sans);text-transform:uppercase;color:var(--a-soft);margin-bottom:8px">Rechnungsadresse</h3>
          <p style="white-space:pre-line;margin:0"><%= addressLib.format(billing) %></p>
        </div>
      </div>
    </div>

    <% if (order.customer_note) { %>
      <div class="card">
        <div class="card__head"><h2>Anmerkung des Kunden</h2></div>
        <div class="card__body" style="white-space:pre-line"><%= order.customer_note %></div>
      </div>
    <% } %>

    <% if (adminCan('belege')) { %>
    <div class="card">
      <div class="card__head"><h2>Belege</h2></div>
      <div class="card__body card__body--flush">
        <% if (!documents.length) { %>
          <p style="padding:18px;margin:0;color:var(--a-soft)">Noch kein Beleg ausgestellt.</p>
        <% } else { %>
        <table class="tbl">
          <thead><tr><th>Beleg</th><th>Art</th><th>Datum</th><th>Fällig</th><th class="num">Betrag</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% documents.forEach(function (d) { %>
              <tr>
                <td><a class="link" href="/verwaltung/belege/<%= d.id %>"><%= d.number %></a></td>
                <td><%= (documentTypes[d.doc_type] || {}).label || d.doc_type %></td>
                <td><%= formatDay(d.issued_at) %></td>
                <td><%= d.due_at || '–' %></td>
                <td class="num"><%= fmt(d.total_cents) %></td>
                <td><span class="pill <%= d.status === 'storniert' ? 'pill--err' : 'pill--ok' %>"><%= d.status %></span></td>
                <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/belege/<%= d.id %>/pdf" target="_blank" rel="noopener">PDF</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
        <% if (adminCan('belege.ausstellen') && order.status !== 'storniert') { %>
        <div style="padding:16px;border-top:1px solid var(--a-line)">
          <form method="post" action="/verwaltung/bestellungen/<%= order.id %>/beleg" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <label class="field" style="margin:0"><span>Belegart</span>
              <select name="doc_type">
                <option value="rechnung">Rechnung</option>
                <option value="lieferschein">Lieferschein</option>
                <option value="gutschrift">Gutschrift</option>
              </select>
            </label>
            <label class="field" style="margin:0;flex:1 1 240px"><span>Hinweis auf dem Beleg</span><input type="text" name="note" maxlength="500"></label>
            <button class="btn btn--dark" type="submit">Beleg ausstellen</button>
          </form>
          <p style="margin:10px 0 0;font-size:12.5px;color:var(--a-soft)">Ein ausgestellter Beleg bleibt unverändert. Korrekturen entstehen als Storno und neuer Beleg.</p>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <% if (adminCan('produktion') && productions.length) { %>
    <div class="card">
      <div class="card__head"><h2>Fertigungsstand</h2></div>
      <div class="card__body card__body--flush">
        <table class="tbl">
          <thead><tr><th>Auftrag</th><th>Titel</th><th class="num">Menge</th><th>Fortschritt</th><th>Zuständig</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% productions.forEach(function (p) { %>
              <tr>
                <td><%= p.number %></td><td><%= p.title %></td><td class="num"><%= p.qty %></td>
                <td><span class="kanban__bar" style="display:block;width:110px"><i style="width:<%= p.progress %>%"></i></span><span style="font-size:12px;color:var(--a-soft)"><%= p.step_done %>/<%= p.step_count %> Schritte</span></td>
                <td><%= p.assignee_name || '–' %></td>
                <td><span class="pill <%= p.status === 'fertig' ? 'pill--ok' : '' %>"><%= productionStates[p.status] || p.status %></span></td>
                <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/produktion/<%= p.id %>">Öffnen</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <% if (adminCan('versand')) { %>
    <div class="card">
      <div class="card__head"><h2>Sendungen</h2></div>
      <div class="card__body card__body--flush">
        <% if (!shipments.length) { %>
          <p style="padding:18px;margin:0;color:var(--a-soft)">Noch keine Sendung angelegt.</p>
        <% } else { %>
        <table class="tbl">
          <thead><tr><th>Sendung</th><th>Dienstleister</th><th class="num">Packstücke</th><th>Sendungsnummer</th><th>Status</th><th></th></tr></thead>
          <tbody>
            <% shipments.forEach(function (s) { %>
              <tr>
                <td><a class="link" href="/verwaltung/versand/<%= s.id %>">#<%= s.id %></a><br><span style="font-size:12px;color:var(--a-soft)"><%= s.items.length %> Position(en)</span></td>
                <td><%= s.carrier_name || s.carrier_code || '–' %><br><span style="font-size:12px;color:var(--a-soft)"><%= s.source === 'api' ? 'über Schnittstelle' : 'manuell erfasst' %></span></td>
                <td class="num"><%= s.packages.length %></td>
                <td><% if (s.tracking_link) { %><a class="link" href="<%= s.tracking_link %>" target="_blank" rel="noopener nofollow"><%= s.tracking_code %></a><% } else { %><%= s.tracking_code || '–' %><% } %></td>
                <td><span class="pill"><%= shipmentStates[s.status] || s.status %></span></td>
                <td class="num"><a class="btn btn--ghost btn--sm" href="/verwaltung/versand/<%= s.id %>">Öffnen</a></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
        <% var openSum = openItems.reduce(function (a, i) { return a + i.open_qty; }, 0); %>
        <% if (order.status !== 'storniert' && openSum > 0) { %>
        <div style="padding:16px;border-top:1px solid var(--a-line)">
          <form method="post" action="/verwaltung/bestellungen/<%= order.id %>/versand">
            <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
            <table class="tbl" style="margin-bottom:12px">
              <thead><tr><th>Position</th><th class="num">Bestellt</th><th class="num">Versandt</th><th class="num">Jetzt versenden</th></tr></thead>
              <tbody>
                <% openItems.forEach(function (i) { %>
                  <tr>
                    <td><%= i.name %><% if (i.variant_name) { %> – <%= i.variant_name %><% } %></td>
                    <td class="num"><%= i.qty %></td>
                    <td class="num"><%= i.shipped_qty %></td>
                    <td class="num"><input type="number" name="versandmenge_<%= i.id %>" min="0" max="<%= i.open_qty %>" value="<%= i.open_qty %>" style="width:80px"></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
            <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end">
              <label class="field" style="margin:0"><span>Dienstleister</span>
                <select name="carrier_code">
                  <% carriers.forEach(function (c) { %><option value="<%= c.code %>"><%= c.name %></option><% }); %>
                </select>
              </label>
              <label class="field" style="margin:0"><span>Packstücke</span><input type="number" name="packages" min="1" max="50" value="1" style="width:90px"></label>
              <label class="field" style="margin:0"><span>Gewicht (g)</span><input type="number" name="weight_g" min="0" value="0" style="width:110px"></label>
              <label class="field" style="margin:0;flex:1 1 200px"><span>Sendungsnummer (manuell)</span><input type="text" name="tracking_code" maxlength="60"></label>
              <button class="btn btn--dark" type="submit">Sendung anlegen</button>
            </div>
          </form>
        </div>
        <% } %>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card__head"><h2>Verlauf</h2></div>
      <div class="card__body card__body--flush">
        <table class="tbl">
          <tbody>
            <% log.forEach(function (l) { %>
              <tr><td><%= l.action %></td><td><%= l.detail %></td><td style="color:var(--a-soft)"><%= l.actor %> · <%= formatDate(l.created_at) %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div>
    <% if (adminCan('bestellungen.bearbeiten')) { %>
    <div class="card">
      <div class="card__head"><h2>Status pflegen</h2></div>
      <div class="card__body">
        <form method="post" action="/verwaltung/bestellungen/<%= order.id %>">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <label class="field"><span>Bestellstatus</span>
            <select name="status">
              <% statuses.filter(function (s) { return s !== 'storniert' || order.status === 'storniert'; }).forEach(function (s) { %><option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option><% }); %>
            </select>
          </label>
          <label class="field"><span>Zahlungsstatus</span>
            <select name="payment_status">
              <% paymentStatuses.forEach(function (s) { %><option value="<%= s %>" <%= order.payment_status === s ? 'selected' : '' %>><%= s %></option><% }); %>
            </select>
          </label>
          <label class="field"><span>Versandstatus</span>
            <select name="shipping_status">
              <% shippingStatuses.forEach(function (s) { %><option value="<%= s %>" <%= order.shipping_status === s ? 'selected' : '' %>><%= s %></option><% }); %>
            </select>
          </label>
          <label class="field"><span>Sendungsnummer</span><input type="text" name="tracking_code" value="<%= order.tracking_code %>"></label>
          <label class="field"><span>Interne Notiz</span><textarea name="internal_note" rows="4"><%= order.internal_note %></textarea></label>
          <button class="btn btn--primary btn--block" type="submit">Speichern</button>
        </form>
      </div>
    </div>
    <% } %>

    <div class="card">
      <div class="card__head"><h2>Kunde</h2></div>
      <div class="card__body" style="font-size:14px">
        <p style="margin:0 0 6px"><strong><%= order.email %></strong></p>
        <% if (customer) { %>
          <p style="margin:0 0 10px;color:var(--a-soft)"><%= customer.first_name %> <%= customer.last_name %> · Kunde seit <%= formatDay(customer.created_at) %></p>
          <a class="btn btn--ghost btn--sm" href="/verwaltung/kunden/<%= customer.id %>">Kundenakte öffnen</a>
        <% } else { %>
          <p style="margin:0;color:var(--a-soft)">Bestellung als Gast – kein Kundenkonto verknüpft.</p>
        <% } %>
      </div>
    </div>

    <% if (adminCan('bestellungen.bearbeiten')) { %>
    <div class="card">
      <div class="card__head"><h2>Stornieren</h2></div>
      <div class="card__body">
        <p style="color:var(--a-soft);font-size:13px;margin:0 0 12px">
          Beim Stornieren wird der Bestand aller Positionen automatisch zurückgebucht und eine Gutscheinnutzung zurückgesetzt.
        </p>
        <% if (order.status === 'storniert' || ['bezahlt', 'erstattet'].includes(order.payment_status) || ['versandt', 'zugestellt', 'retoure'].includes(order.shipping_status)) { %>
          <p style="color:var(--a-soft);font-size:13px">Eine bereits stornierte, bezahlte oder versandte Bestellung wird hier nicht automatisch zurückgebucht. Dafür ist eine gesonderte Erstattungs- bzw. Retourenprüfung nötig.</p>
        <% } else { %>
        <form method="post" action="/verwaltung/bestellungen/<%= order.id %>/stornieren" data-confirm="Bestellung wirklich stornieren und Bestand zurückbuchen?">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <button class="btn btn--danger btn--block" type="submit">Bestellung stornieren</button>
        </form>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
</div>
<%- include('../partials/admin-foot') %>
