<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/gebietsbuch">Zur Übersicht</a> <a class="btn btn--ghost btn--sm" target="_blank" rel="noopener" href="/verwaltung/gebietsbuch/' + book.id + '/druck">Drucken</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<% if (duplicates.length) { %>
  <div class="ad-alert ad-alert--warn">
    <strong>Mögliche Dubletten:</strong>
    <% duplicates.forEach(function (d, i) { %><%= i ? ' · ' : ' ' %><%= d.company %> (<%= d.city || 'ohne Ort' %>, <%= d.anzahl %>×)<% }); %>
  </div>
<% } %>
<div class="toolbar">
  <form method="get" action="/verwaltung/gebietsbuch/<%= book.id %>">
    <input type="search" name="q" value="<%= q %>" placeholder="Firma, Ort, Branche" aria-label="Suche">
    <select name="kontakt" aria-label="Kontaktstatus">
      <option value="">Alle Status</option>
      <% Object.keys(contactStates).forEach(function (k) { %><option value="<%= k %>" <%= contact === k ? 'selected' : '' %>><%= contactStates[k] %></option><% }); %>
    </select>
    <button class="btn btn--dark btn--sm" type="submit">Filtern</button>
    <a class="btn btn--ghost btn--sm" href="/verwaltung/gebietsbuch/<%= book.id %>">Zurücksetzen</a>
  </form>
</div>
<div class="card">
  <div class="card__head"><h2><%= rows.length %> Einträge · <%= book.territory_name || 'ohne Gebiet' %></h2></div>
  <div class="card__body card__body--flush">
    <% if (!rows.length) { %><p style="padding:20px;margin:0;color:var(--a-soft)">Keine Einträge.</p><% } else { %>
    <table class="tbl">
      <thead><tr><th>Firma</th><th>Branche</th><th>Kontakt</th><th>Ort</th><th>Status</th><th>Wiedervorlage</th><th>Zuständig</th><th></th></tr></thead>
      <tbody>
        <% rows.forEach(function (e) { %>
          <tr>
            <td>
              <form method="post" action="/verwaltung/gebietsbuch/<%= book.id %>/eintrag/<%= e.id %>" id="eintrag-<%= e.id %>">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="text" name="company" value="<%= e.company %>" maxlength="160" style="width:100%">
              </form>
            </td>
            <td><input form="eintrag-<%= e.id %>" type="text" name="branch" value="<%= e.branch %>" maxlength="100" style="width:110px"></td>
            <td>
              <input form="eintrag-<%= e.id %>" type="text" name="contact" value="<%= e.contact %>" maxlength="120" style="width:120px"><br>
              <input form="eintrag-<%= e.id %>" type="text" name="phone" value="<%= e.phone %>" maxlength="60" style="width:120px" placeholder="Telefon">
            </td>
            <td>
              <input form="eintrag-<%= e.id %>" type="text" name="zip" value="<%= e.zip %>" maxlength="12" style="width:64px">
              <input form="eintrag-<%= e.id %>" type="text" name="city" value="<%= e.city %>" maxlength="80" style="width:110px">
            </td>
            <td>
              <select form="eintrag-<%= e.id %>" name="contact_status">
                <% Object.keys(contactStates).forEach(function (k) { %><option value="<%= k %>" <%= e.contact_status === k ? 'selected' : '' %>><%= contactStates[k] %></option><% }); %>
              </select>
            </td>
            <td><input form="eintrag-<%= e.id %>" type="date" name="followup_at" value="<%= e.followup_at || '' %>"></td>
            <td>
              <select form="eintrag-<%= e.id %>" name="owner_id" <%= adminCan('gebietsbuch.verwalten') ? '' : 'disabled' %>>
                <option value="">– offen –</option>
                <% advisors.forEach(function (a) { %><option value="<%= a.id %>" <%= String(e.owner_id || '') === String(a.id) ? 'selected' : '' %>><%= a.name || a.email %></option><% }); %>
              </select>
            </td>
            <td class="num"><button form="eintrag-<%= e.id %>" class="btn btn--dark btn--sm" type="submit">Speichern</button></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>
<div class="cols">
  <div class="card">
    <div class="card__head"><h2>Eintrag hinzufügen</h2></div>
    <div class="card__body">
      <form method="post" action="/verwaltung/gebietsbuch/<%= book.id %>/eintrag">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <div class="field-row">
          <label class="field"><span>Firma *</span><input type="text" name="company" required maxlength="160"></label>
          <label class="field"><span>Branche</span><input type="text" name="branch" maxlength="100"></label>
        </div>
        <div class="field-row">
          <label class="field"><span>Kontakt</span><input type="text" name="contact" maxlength="120"></label>
          <label class="field"><span>Telefon</span><input type="text" name="phone" maxlength="60"></label>
        </div>
        <div class="field-row">
          <label class="field"><span>PLZ</span><input type="text" name="zip" maxlength="12"></label>
          <label class="field"><span>Ort</span><input type="text" name="city" maxlength="80"></label>
        </div>
        <label class="field"><span>E-Mail</span><input type="email" name="email" maxlength="160"></label>
        <button class="btn btn--primary" type="submit">Hinzufügen</button>
      </form>
    </div>
  </div>
  <% if (adminCan('gebietsbuch.verwalten')) { %>
  <div class="card">
    <div class="card__head"><h2>Import</h2></div>
    <div class="card__body">
      <form method="post" action="/verwaltung/gebietsbuch/<%= book.id %>/import">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <label class="field"><span>Zeilen: Firma;Branche;Kontakt;E-Mail;Telefon;Straße;PLZ;Ort</span>
          <textarea name="csv" rows="7" placeholder="Nordfisch GmbH;Großhandel;Jan Petersen;jan@example.de;04841 1234;Hafenstraße 4;25813;Husum"></textarea>
        </label>
        <button class="btn btn--dark" type="submit">Importieren</button>
        <p style="margin:10px 0 0;font-size:12.5px;color:var(--a-soft)">Bereits vorhandene Firma-/Ort-Kombinationen werden übersprungen.</p>
      </form>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/admin-foot') %>
