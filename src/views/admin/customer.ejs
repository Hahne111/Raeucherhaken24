<%- include('../partials/admin-head') %>
<%
var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/kunden">Zur Kundenliste</a>';
if (adminCan('kunden.bearbeiten')) headActions += ' <a class="btn btn--primary btn--sm" href="/verwaltung/kunden/' + row.id + '/bearbeiten">Bearbeiten</a>';
%>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="cols">
  <div>
    <% if (duplicates.length) { %>
      <div class="ad-alert ad-alert--warn">
        Mögliche Dubletten:
        <% duplicates.forEach(function (d, i) { %><%= i ? ', ' : '' %><a class="link" href="/verwaltung/kunden/<%= d.id %>"><%= d.company || ((d.first_name + ' ' + d.last_name).trim() || d.email) %></a><% }); %>
      </div>
    <% } %>

    <div class="card">
      <div class="card__head"><h2>Bestellungen</h2></div>
      <div class="card__body card__body--flush">
        <% if (!orders.length) { %>
          <p style="padding:18px;margin:0;color:var(--a-soft)">Noch keine Bestellung.</p>
        <% } else { %>
        <table class="tbl">
          <thead><tr><th>Nummer</th><th>Datum</th><th>Status</th><th>Zahlung</th><th class="num">Summe</th><th></th></tr></thead>
          <tbody>
            <% orders.forEach(function (o) { %>
              <tr>
                <td><%= o.number %></td><td><%= formatDay(o.created_at) %></td>
                <td><span class="pill"><%= o.status %></span></td>
                <td><span class="pill"><%= o.payment_status %></span></td>
                <td class="num"><%= fmt(o.total_cents) %></td>
                <td class="num"><% if (adminCan('bestellungen.lesen')) { %><a class="btn btn--ghost btn--sm" href="/verwaltung/bestellungen/<%= o.id %>">Öffnen</a><% } %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><h2>Beratungen und Termine</h2></div>
      <div class="card__body">
        <% if (!consultations.length && !appointments.length) { %>
          <p style="margin:0;color:var(--a-soft)">Noch keine Beratung und kein Termin erfasst.</p>
        <% } %>
        <% if (consultations.length) { %>
          <h3 style="font-size:14px;margin:0 0 8px">Beratungen</h3>
          <ul style="margin:0 0 16px;padding-left:18px">
            <% consultations.forEach(function (c) { %>
              <li><a class="link" href="/verwaltung/beratung/<%= c.id %>"><%= c.title || ('Beratung #' + c.id) %></a> · <%= c.status %> · <%= formatDay(c.created_at) %></li>
            <% }); %>
          </ul>
        <% } %>
        <% if (appointments.length) { %>
          <h3 style="font-size:14px;margin:0 0 8px">Termine</h3>
          <ul style="margin:0;padding-left:18px">
            <% appointments.forEach(function (a) { %>
              <li><a class="link" href="/verwaltung/termine/<%= a.id %>"><%= a.title %></a> · <%= formatDate(a.starts_at) %> · <%= a.status %></li>
            <% }); %>
          </ul>
        <% } %>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><h2>Kundenakte</h2></div>
      <div class="card__body">
        <% if (adminCan('kunden.bearbeiten')) { %>
        <form method="post" action="/verwaltung/kunden/<%= row.id %>/notiz" style="margin-bottom:18px">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="field-row">
            <label class="field"><span>Art</span>
              <select name="kind">
                <option value="notiz">Notiz</option>
                <option value="anruf">Anruf</option>
                <option value="besuch">Besuch</option>
                <option value="mail">E-Mail</option>
              </select>
            </label>
            <label class="field"><span>Betreff</span><input type="text" name="title" maxlength="200" placeholder="z. B. Rückruf vereinbart"></label>
          </div>
          <label class="field"><span>Text</span><textarea name="body" rows="3"></textarea></label>
          <button class="btn btn--dark btn--sm" type="submit">Eintrag speichern</button>
        </form>
        <% } %>
        <% if (!activities.length) { %>
          <p style="margin:0;color:var(--a-soft)">Noch keine Einträge.</p>
        <% } else { %>
          <ol style="list-style:none;margin:0;padding:0">
            <% activities.forEach(function (a) { %>
              <li style="border-left:2px solid var(--a-line);padding:0 0 14px 14px">
                <div style="font-size:12.5px;color:var(--a-soft)"><%= formatDate(a.created_at) %> · <%= a.kind %> · <%= a.created_by || 'System' %></div>
                <strong style="font-size:14px"><%= a.title %></strong>
                <% if (a.body) { %><div style="font-size:13.5px;white-space:pre-line"><%= a.body %></div><% } %>
              </li>
            <% }); %>
          </ol>
        <% } %>
      </div>
    </div>
  </div>

  <div>
    <div class="card">
      <div class="card__head"><h2>Stammdaten</h2></div>
      <div class="card__body">
        <p style="margin:0 0 14px;font-size:14px">
          <strong><%= row.company || ((row.first_name + ' ' + row.last_name).trim() || row.email) %></strong><br>
          <span style="color:var(--a-soft)"><%= row.email %><%= row.phone ? ' · ' + row.phone : '' %></span><br>
          <span style="color:var(--a-soft)">Kunde seit <%= formatDay(row.created_at) %><%= row.last_login_at ? ' · zuletzt aktiv ' + formatDate(row.last_login_at) : '' %></span>
        </p>
        <table class="tbl tbl--plain">
          <tbody>
            <tr><th style="text-align:left">Typ</th><td><%= types[row.customer_type] || row.customer_type %></td></tr>
            <tr><th style="text-align:left">Status</th><td><%= states[row.customer_status] || row.customer_status %></td></tr>
            <tr><th style="text-align:left">Zahlungsziel</th><td><%= row.payment_terms_days %> Tage</td></tr>
            <tr><th style="text-align:left">Rabatt</th><td><%= row.discount_percent %> %</td></tr>
            <tr><th style="text-align:left">USt-IdNr.</th><td><%= row.vat_id || '–' %></td></tr>
            <tr><th style="text-align:left">Berater</th><td><%= row.advisor_name || '–' %></td></tr>
            <tr><th style="text-align:left">Tags</th><td><%= row.tags || '–' %></td></tr>
            <tr><th style="text-align:left">Konto</th><td><%= row.active ? 'aktiv' : 'gesperrt' %><%= row.newsletter ? ' · Newsletter' : '' %></td></tr>
          </tbody>
        </table>
        <% if (row.note) { %><p style="margin:14px 0 0;white-space:pre-line;font-size:13.5px"><%= row.note %></p><% } %>
      </div>
    </div>

    <div class="card">
      <div class="card__head"><h2>Adressen</h2></div>
      <div class="card__body">
        <% if (!addresses.length) { %>
          <p style="margin:0;color:var(--a-soft)">Keine gespeicherten Adressen.</p>
        <% } else { %>
          <div style="display:grid;gap:12px">
            <% addresses.forEach(function (a) { %>
              <div style="border:1px solid var(--a-line);border-radius:4px;padding:12px;font-size:13.5px">
                <strong><%= a.first_name %> <%= a.last_name %></strong><br>
                <span style="color:var(--a-soft)"><%= a.company ? a.company + '<br>' : '' %><%= a.street %><br><%= a.zip %> <%= a.city %><br><%= a.country %></span>
                <% if (a.zip && a.city) { %>
                  <br><a class="link" target="_blank" rel="noopener nofollow"
                        href="https://www.openstreetmap.org/search?query=<%= encodeURIComponent(a.street + ', ' + a.zip + ' ' + a.city) %>">Auf der Karte suchen</a>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/admin-foot') %>
