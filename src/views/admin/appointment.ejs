<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/termine">Zum Kalender</a> <a class="btn btn--primary btn--sm" href="/verwaltung/termine/' + row.id + '/bearbeiten">Bearbeiten</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="cols">
  <div>
    <div class="card">
      <div class="card__head"><h2>Verschieben</h2></div>
      <div class="card__body">
        <form method="post" action="/verwaltung/termine/<%= row.id %>/verschieben" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <label class="field" style="margin:0"><span>Neuer Zeitpunkt</span><input type="datetime-local" name="starts_at" value="<%= row.starts_at %>" required></label>
          <button class="btn btn--dark" type="submit">Verschieben</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Status</h2></div>
      <div class="card__body">
        <form method="post" action="/verwaltung/termine/<%= row.id %>/status" style="display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <label class="field" style="margin:0"><span>Status</span>
            <select name="status">
              <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= row.status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
            </select>
          </label>
          <% if (seriesCount > 1) { %>
            <label class="check" style="margin:0"><input type="checkbox" name="serie" value="1"><span>für alle folgenden Termine der Serie (<%= seriesCount %>)</span></label>
          <% } %>
          <button class="btn btn--dark" type="submit">Speichern</button>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Erinnerungen</h2></div>
      <div class="card__body card__body--flush">
        <% if (!reminders.length) { %>
          <p style="padding:18px;margin:0;color:var(--a-soft)">Für diesen Termin ist keine Erinnerung geplant.</p>
        <% } else { %>
        <table class="tbl">
          <thead><tr><th>Empfänger</th><th>Fällig</th><th>Status</th><th>Hinweis</th></tr></thead>
          <tbody>
            <% reminders.forEach(function (r) { %>
              <tr>
                <td><%= r.recipient %></td>
                <td><%= String(r.due_at).replace('T',' ') %></td>
                <td><span class="pill <%= r.status === 'eingestellt' ? 'pill--ok' : (r.status === 'gesperrt' ? 'pill--err' : '') %>"><%= r.status %></span></td>
                <td><%= r.detail || '–' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        <% } %>
        <% if (!mailStatus.configured) { %>
          <p style="padding:14px 18px;margin:0;font-size:12.5px;color:var(--a-soft)">Systemmail ist nicht eingerichtet – es fehlt: <%= mailStatus.missing.join(', ') %>. Erinnerungen werden geplant, aber nicht versendet.</p>
        <% } %>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card__head"><h2>Termin</h2></div>
    <div class="card__body">
      <table class="tbl tbl--plain"><tbody>
        <tr><th style="text-align:left">Beginn</th><td><%= String(row.starts_at).replace('T',' ') %> Uhr</td></tr>
        <tr><th style="text-align:left">Ende</th><td><%= row.ends_at ? String(row.ends_at).replace('T',' ') + ' Uhr' : '–' %></td></tr>
        <tr><th style="text-align:left">Art</th><td><%= kinds[row.kind] || row.kind %></td></tr>
        <tr><th style="text-align:left">Priorität</th><td><%= priorities[row.priority] || row.priority %></td></tr>
        <tr><th style="text-align:left">Status</th><td><%= states[row.status] || row.status %></td></tr>
        <tr><th style="text-align:left">Ort</th><td><%= row.location || '–' %></td></tr>
        <tr><th style="text-align:left">Zuständig</th><td><%= row.owner_name || '–' %></td></tr>
        <tr><th style="text-align:left">Kunde</th><td><% if (row.customer_id) { %><a class="link" href="/verwaltung/kunden/<%= row.customer_id %>"><%= row.customer_company || row.customer_email %></a><% } else { %>–<% } %></td></tr>
        <tr><th style="text-align:left">Händler</th><td><% if (row.dealer_id) { %><a class="link" href="/verwaltung/haendler/<%= row.dealer_id %>"><%= row.dealer_name %></a><% } else { %>–<% } %></td></tr>
        <tr><th style="text-align:left">Serie</th><td><%= seriesCount > 1 ? seriesCount + ' Termine' : 'Einzeltermin' %></td></tr>
      </tbody></table>
      <% if (row.note) { %><h3 style="font-size:14px;margin:16px 0 6px">Notiz</h3><p style="margin:0;white-space:pre-line;font-size:13.5px"><%= row.note %></p><% } %>
      <% if (participants.length) { %>
        <h3 style="font-size:14px;margin:16px 0 6px">Teilnehmer</h3>
        <ul style="margin:0;padding-left:18px"><% participants.forEach(function (p) { %><li><%= p.name || p.email %></li><% }); %></ul>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/admin-foot') %>
