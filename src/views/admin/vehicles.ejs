<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/fahrten">Zum Fahrtenbuch</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="cols">
  <div class="card">
    <div class="card__head"><h2>Fahrzeug anlegen</h2></div>
    <div class="card__body">
      <form method="post" action="/verwaltung/fahrzeuge">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <label>Bezeichnung <input type="text" name="label" required maxlength="120" placeholder="z. B. Transporter Nord"></label>
        <label>Kennzeichen <input type="text" name="plate" maxlength="40"></label>
        <label>Fahrer
          <select name="advisor_id">
            <option value="">nicht zugeordnet</option>
            <% advisors.forEach(function (a) { %><option value="<%= a.id %>"><%= a.name || a.email %></option><% }); %>
          </select>
        </label>
        <label>Anfangsstand in km <input type="number" name="start_km" value="0" min="0"></label>
        <label>Notiz <textarea name="note" rows="2" maxlength="500"></textarea></label>
        <button class="btn btn--dark" type="submit">Speichern</button>
      </form>
    </div>
  </div>
  <div class="card">
    <div class="card__head"><h2>Fahrzeuge</h2></div>
    <div class="card__body card__body--flush">
      <% if (!rows.length) { %>
        <p style="padding:20px;margin:0;color:var(--a-soft)">Noch kein Fahrzeug angelegt.</p>
      <% } else { %>
      <table class="tbl">
        <thead><tr><th>Fahrzeug</th><th>Kennzeichen</th><th>Fahrer</th><th class="num">Stand</th><th>Status</th><th style="width:150px">Ändern</th></tr></thead>
        <tbody>
          <% rows.forEach(function (r) { %>
          <tr>
            <td><%= r.label %></td>
            <td><%= r.plate || '–' %></td>
            <td><%= r.advisor_name || '–' %></td>
            <td class="num"><%= r.current_km %> km</td>
            <td><span class="pill <%= r.active ? 'pill--ok' : '' %>"><%= r.active ? 'Aktiv' : 'Stillgelegt' %></span></td>
            <td>
              <form method="post" action="/verwaltung/fahrzeuge">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <input type="hidden" name="id" value="<%= r.id %>">
                <input type="hidden" name="label" value="<%= r.label %>">
                <input type="hidden" name="plate" value="<%= r.plate %>">
                <input type="hidden" name="advisor_id" value="<%= r.advisor_id || '' %>">
                <input type="hidden" name="start_km" value="<%= r.start_km %>">
                <input type="hidden" name="note" value="<%= r.note %>">
                <% if (r.active) { %>
                  <button class="btn btn--ghost btn--sm" type="submit">Stilllegen</button>
                <% } else { %>
                  <input type="hidden" name="active" value="1">
                  <button class="btn btn--ghost btn--sm" type="submit">Wieder aktivieren</button>
                <% } %>
              </form>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/admin-foot') %>
