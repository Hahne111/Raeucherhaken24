<%- include('../partials/admin-head') %>
<% var headActions = '<a class="btn btn--ghost btn--sm" href="/verwaltung/versand">Zur Versandliste</a> <a class="btn btn--ghost btn--sm" href="/verwaltung/bestellungen/' + row.order_id + '">Zur Bestellung</a>'; %>
<%- include('../partials/admin-shell', { headActions: headActions }) %>
<div class="cols">
  <div>
    <div class="card">
      <div class="card__head"><h2>Positionen</h2></div>
      <div class="card__body card__body--flush">
        <table class="tbl">
          <thead><tr><th>Artikel</th><th>Art.-Nr.</th><th class="num">In dieser Sendung</th><th class="num">Bestellt</th></tr></thead>
          <tbody>
            <% row.items.forEach(function (i) { %>
              <tr><td><%= i.name %><%= i.variant_name ? ' – ' + i.variant_name : '' %></td><td><%= i.sku %></td>
                <td class="num"><%= i.qty %></td><td class="num"><%= i.ordered_qty %></td></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Packstücke und Sendungsnummern</h2></div>
      <div class="card__body">
        <form method="post" action="/verwaltung/versand/<%= row.id %>/tracking">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <div class="field-row">
            <label class="field"><span>Dienstleister</span>
              <select name="carrier_code">
                <option value="">– offen –</option>
                <% carriers.forEach(function (c) { %><option value="<%= c.code %>" <%= row.carrier_code === c.code ? 'selected' : '' %>><%= c.name %></option><% }); %>
              </select>
            </label>
            <label class="field"><span>Sendungsnummer der Sendung</span><input type="text" name="tracking_code" value="<%= row.tracking_code %>" maxlength="60"></label>
          </div>
          <table class="tbl" style="margin-bottom:12px">
            <thead><tr><th>Packstück</th><th>Sendungsnummer</th><th class="num">Gewicht (g)</th></tr></thead>
            <tbody>
              <% row.packages.forEach(function (p) { %>
                <tr><td>#<%= p.package_no %></td>
                  <td><input type="text" name="paket_<%= p.id %>" value="<%= p.tracking_code %>" maxlength="60" style="width:100%"></td>
                  <td class="num"><%= p.weight_g %></td></tr>
              <% }); %>
            </tbody>
          </table>
          <button class="btn btn--dark" type="submit">Sendungsnummern speichern</button>
          <span style="margin-left:10px;font-size:12.5px;color:var(--a-soft)">Manuelle Eingabe – wird als solche gekennzeichnet.</span>
        </form>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Verlauf</h2></div>
      <div class="card__body card__body--flush">
        <table class="tbl"><tbody>
          <% row.events.forEach(function (e) { %>
            <tr><td><%= states[e.status] || e.status %></td><td><%= e.detail %></td><td style="color:var(--a-soft)"><%= e.actor %> · <%= formatDate(e.created_at) %></td></tr>
          <% }); %>
        </tbody></table>
      </div>
    </div>
  </div>
  <div>
    <div class="card">
      <div class="card__head"><h2>Sendung</h2></div>
      <div class="card__body">
        <table class="tbl tbl--plain"><tbody>
          <tr><th style="text-align:left">Bestellung</th><td><a class="link" href="/verwaltung/bestellungen/<%= row.order_id %>"><%= row.order_number %></a></td></tr>
          <tr><th style="text-align:left">Dienstleister</th><td><%= row.carrier_name || row.carrier_code || '–' %></td></tr>
          <tr><th style="text-align:left">Quelle</th><td><%= row.source === 'api' ? 'über Schnittstelle erzeugt' : 'manuell erfasst' %></td></tr>
          <tr><th style="text-align:left">Status</th><td><%= states[row.status] || row.status %></td></tr>
          <tr><th style="text-align:left">Übergeben</th><td><%= row.shipped_at ? formatDate(row.shipped_at) : '–' %></td></tr>
          <tr><th style="text-align:left">Zugestellt</th><td><%= row.delivered_at ? formatDate(row.delivered_at) : '–' %></td></tr>
          <tr><th style="text-align:left">Tracking</th><td><% if (row.tracking_link) { %><a class="link" href="<%= row.tracking_link %>" target="_blank" rel="noopener nofollow"><%= row.tracking_code %></a><% } else { %><%= row.tracking_code || '–' %><% } %></td></tr>
        </tbody></table>
        <h3 style="font-size:14px;margin:16px 0 6px">Lieferanschrift</h3>
        <p style="margin:0;font-size:13.5px;white-space:pre-line"><%= [address.company, ((address.first_name||'') + ' ' + (address.last_name||'')).trim(), address.street, ((address.zip||'') + ' ' + (address.city||'')).trim()].filter(Boolean).join('\n') %></p>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Status setzen</h2></div>
      <div class="card__body">
        <form method="post" action="/verwaltung/versand/<%= row.id %>/status">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <label class="field"><span>Status</span>
            <select name="status">
              <% Object.keys(states).forEach(function (k) { %><option value="<%= k %>" <%= row.status === k ? 'selected' : '' %>><%= states[k] %></option><% }); %>
            </select>
          </label>
          <label class="field"><span>Hinweis</span><input type="text" name="detail" maxlength="300"></label>
          <button class="btn btn--primary btn--block" type="submit">Speichern</button>
        </form>
        <p style="margin:10px 0 0;font-size:12.5px;color:var(--a-soft)">Der Versandstatus der Bestellung folgt automatisch allen Sendungen.</p>
      </div>
    </div>
    <div class="card">
      <div class="card__head"><h2>Etikett</h2></div>
      <div class="card__body">
        <p style="margin:0 0 12px;font-size:13.5px">
          <% if (api.configured) { %>
            Zugangsdaten liegen vor, die Anbindung ist aber noch nicht gegen die Schnittstelle geprüft.
          <% } else { %>
            Keine Anbindung eingerichtet. Es fehlt: <strong><%= api.missing.join(', ') || 'Auswahl des Dienstleisters' %></strong>.
          <% } %>
        </p>
        <form method="post" action="/verwaltung/versand/<%= row.id %>/etikett">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <button class="btn btn--ghost btn--block" type="submit">Etikett anfordern</button>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/admin-foot') %>
