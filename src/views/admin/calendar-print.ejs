<!doctype html>
<html lang="de"><head><meta charset="utf-8"><title><%= range.title %> – Termine</title>
<link rel="stylesheet" href="/css/admin.css">
</head><body class="is-print">
<h1 style="font-size:20px;margin:0 0 4px"><%= range.title %></h1>
<p style="margin:0 0 16px;font-size:12px;color:#555">Räucherhaken24 · Terminübersicht · Stand <%= formatDate(new Date().toISOString()) %></p>
<table class="tbl">
  <thead><tr><th>Zeit</th><th>Titel</th><th>Art</th><th>Kunde / Händler</th><th>Zuständig</th><th>Status</th></tr></thead>
  <tbody>
    <% if (!rows.length) { %><tr><td colspan="6">Keine Termine im Zeitraum.</td></tr><% } %>
    <% rows.forEach(function (it) { %>
      <tr>
        <td><%= String(it.starts_at).replace('T',' ') %></td>
        <td><%= it.title %></td>
        <td><%= kinds[it.kind] || it.kind %></td>
        <td><%= it.customer_company || it.customer_last_name || it.customer_email || it.dealer_name || '–' %></td>
        <td><%= it.owner_name || '–' %></td>
        <td><%= states[it.status] || it.status %></td>
      </tr>
    <% }); %>
  </tbody>
</table>
<p style="margin-top:18px;font-size:12px;color:#555">Über „Drucken“ des Browsers als PDF sichern.</p>
</body></html>
