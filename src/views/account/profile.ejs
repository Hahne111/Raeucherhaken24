<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="inhalt" class="page">
  <div class="wrap">
    <nav class="crumbs" aria-label="Pfad"><a href="/">Start</a><span>/</span><a href="/konto">Mein Konto</a><span>/</span><span>Meine Daten</span></nav>
    <div class="section">
      <div class="pagehead"><h1>Meine Daten</h1></div>
      <div class="account-layout">
        <%- include('../partials/account-nav') %>
        <div>
          <div class="panel" style="margin-bottom:20px">
            <div class="panel__head"><h2>Kontaktdaten</h2></div>
            <div class="panel__body">
              <form method="post" action="/konto/daten" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <div class="field-row">
                  <label class="field <%= errors.first_name ? 'field--error' : '' %>"><span>Vorname</span>
                    <input type="text" name="first_name" value="<%= values.first_name %>" required>
                    <% if (errors.first_name) { %><span class="field__error"><%= errors.first_name %></span><% } %>
                  </label>
                  <label class="field <%= errors.last_name ? 'field--error' : '' %>"><span>Nachname</span>
                    <input type="text" name="last_name" value="<%= values.last_name %>" required>
                    <% if (errors.last_name) { %><span class="field__error"><%= errors.last_name %></span><% } %>
                  </label>
                </div>
                <label class="field <%= errors.email ? 'field--error' : '' %>"><span>E-Mail-Adresse</span>
                  <input type="email" name="email" value="<%= values.email %>" required>
                  <% if (errors.email) { %><span class="field__error"><%= errors.email %></span><% } %>
                </label>
                <label class="field"><span>Telefon (optional)</span><input type="tel" name="phone" value="<%= values.phone || '' %>"></label>
                <label class="check"><input type="checkbox" name="newsletter" value="1" <%= values.newsletter ? 'checked' : '' %>><span>Rauchzeichen-Newsletter erhalten</span></label>
                <button class="btn btn--primary" type="submit">Daten speichern</button>
              </form>
            </div>
          </div>

          <div class="panel">
            <div class="panel__head"><h2>Passwort ändern</h2></div>
            <div class="panel__body">
              <form method="post" action="/konto/passwort">
                <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                <label class="field"><span>Aktuelles Passwort</span><input type="password" name="current" required autocomplete="current-password"></label>
                <div class="field-row">
                  <label class="field"><span>Neues Passwort</span><input type="password" name="password" required autocomplete="new-password"></label>
                  <label class="field"><span>Wiederholen</span><input type="password" name="password2" required autocomplete="new-password"></label>
                </div>
                <button class="btn btn--dark" type="submit">Passwort ändern</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
