<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="inhalt" class="page">
  <div class="wrap">
    <nav class="crumbs" aria-label="Pfad"><a href="/">Start</a><span>/</span><a href="/konto/bestellungen">Bestellungen</a><span>/</span><span><%= order.number %></span></nav>
    <div class="section">
      <div class="pagehead">
        <p class="pagehead__eyebrow">Bestellt am <%= formatDate(order.created_at) %></p>
        <h1>Bestellung <%= order.number %></h1>
      </div>
      <div class="account-layout">
        <%- include('../partials/account-nav') %>
        <div>
          <div class="panel" style="margin-bottom:20px">
            <div class="panel__head">
              <h2>Status</h2>
              <span class="order-status order-status--<%= order.status.split(' ').pop().toLowerCase() %>"><%= order.status %></span>
            </div>
            <div class="panel__body" style="display:grid;grid-template-columns:repeat(3,1fr);gap:18px;font-size:14.5px">
              <div><strong>Zahlung</strong><br><span style="color:var(--ink-soft)"><%= order.payment_status %> · <%= order.payment_method %></span></div>
              <div><strong>Versand</strong><br><span style="color:var(--ink-soft)"><%= order.shipping_status %> · <%= order.shipping_name %></span></div>
              <div><strong>Sendungsnummer</strong><br><span style="color:var(--ink-soft)"><%= order.tracking_code || 'noch nicht vergeben' %></span></div>
            </div>
          </div>

          <div class="panel" style="margin-bottom:20px">
            <div class="panel__head"><h2>Artikel</h2></div>
            <% items.forEach(function (item) { %>
              <div class="lineitem">
                <a class="lineitem__media" href="/produkt/<%= item.product_slug %>"><img src="<%= item.image %>" alt="" width="92" height="78" loading="lazy"></a>
                <div>
                  <a class="lineitem__title" href="/produkt/<%= item.product_slug %>"><%= item.name %></a>
                  <p class="lineitem__meta"><%= item.variant_name %> · Art.-Nr. <%= item.sku %> · <%= item.qty %> × <%= fmt(item.unit_price_cents) %></p>
                </div>
                <div class="lineitem__right"><strong><%= fmt(item.total_cents) %></strong></div>
              </div>
            <% }); %>
            <div class="panel__body">
              <div class="sumrow"><span>Zwischensumme</span><span><%= fmt(order.subtotal_cents) %></span></div>
              <% if (order.discount_cents > 0) { %><div class="sumrow sumrow--discount"><span>Gutschein <%= order.coupon_code %></span><span>− <%= fmt(order.discount_cents) %></span></div><% } %>
              <div class="sumrow"><span>Versand</span><span><%= order.shipping_cents === 0 ? 'kostenlos' : fmt(order.shipping_cents) %></span></div>
              <div class="sumrow sumrow--total"><span>Gesamt</span><span><%= fmt(order.total_cents) %></span></div>
            </div>
          </div>

          <div class="panel">
            <div class="panel__head"><h2>Adressen</h2></div>
            <div class="panel__body" style="display:grid;grid-template-columns:1fr 1fr;gap:20px;font-size:14.5px">
              <div><h3 style="font-size:13px;font-family:var(--sans);text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px">Lieferadresse</h3>
                <p style="white-space:pre-line;margin:0"><%= addressLib.format(shipping) %></p></div>
              <div><h3 style="font-size:13px;font-family:var(--sans);text-transform:uppercase;color:var(--ink-soft);margin-bottom:8px">Rechnungsadresse</h3>
                <p style="white-space:pre-line;margin:0"><%= addressLib.format(billing) %></p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
