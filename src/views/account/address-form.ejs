<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="inhalt" class="page">
  <div class="wrap">
    <nav class="crumbs" aria-label="Pfad"><a href="/">Start</a><span>/</span><a href="/konto/adressen">Adressen</a><span>/</span><span><%= title %></span></nav>
    <div class="section">
      <div class="pagehead"><h1><%= title %></h1></div>
      <div class="account-layout">
        <%- include('../partials/account-nav') %>
        <div class="panel" style="max-width:640px">
          <div class="panel__body">
            <form method="post" action="<%= action %>" novalidate>
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <label class="field"><span>Bezeichnung</span><input type="text" name="label" value="<%= address.label || 'Adresse' %>"></label>
              <div class="field-row">
                <label class="field <%= errors.first_name ? 'field--error' : '' %>"><span>Vorname</span>
                  <input type="text" name="first_name" value="<%= address.first_name || '' %>" required>
                  <% if (errors.first_name) { %><span class="field__error"><%= errors.first_name %></span><% } %>
                </label>
                <label class="field <%= errors.last_name ? 'field--error' : '' %>"><span>Nachname</span>
                  <input type="text" name="last_name" value="<%= address.last_name || '' %>" required>
                  <% if (errors.last_name) { %><span class="field__error"><%= errors.last_name %></span><% } %>
                </label>
              </div>
              <label class="field"><span>Firma (optional)</span><input type="text" name="company" value="<%= address.company || '' %>"></label>
              <label class="field <%= errors.street ? 'field--error' : '' %>"><span>Straße und Hausnummer</span>
                <input type="text" name="street" value="<%= address.street || '' %>" required>
                <% if (errors.street) { %><span class="field__error"><%= errors.street %></span><% } %>
              </label>
              <div class="field-row">
                <label class="field <%= errors.zip ? 'field--error' : '' %>"><span>PLZ</span>
                  <input type="text" name="zip" value="<%= address.zip || '' %>" required>
                  <% if (errors.zip) { %><span class="field__error"><%= errors.zip %></span><% } %>
                </label>
                <label class="field <%= errors.city ? 'field--error' : '' %>"><span>Ort</span>
                  <input type="text" name="city" value="<%= address.city || '' %>" required>
                  <% if (errors.city) { %><span class="field__error"><%= errors.city %></span><% } %>
                </label>
              </div>
              <div class="field-row">
                <label class="field"><span>Land</span>
                  <select name="country">
                    <% countries.forEach(function (c) { %>
                      <option value="<%= c[0] %>" <%= (address.country || 'DE') === c[0] ? 'selected' : '' %>><%= c[1] %></option>
                    <% }); %>
                  </select>
                </label>
                <label class="field"><span>Telefon (optional)</span><input type="tel" name="phone" value="<%= address.phone || '' %>"></label>
              </div>
              <div style="display:flex;gap:12px">
                <button class="btn btn--primary" type="submit">Speichern</button>
                <a class="btn btn--ghost" href="/konto/adressen">Abbrechen</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
